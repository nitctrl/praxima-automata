{
  "key": "project",
  "name": "Project",
  "plural_name": "Projects",
  "description": "A residential or commercial project being sold.",
  "schema_version": 1,
  "searchable_fields": ["name", "city", "locality", "status"],
  "display_template": {"title": "{name}", "subtitle": "{locality}, {city}"},
  "attributes_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["city", "locality", "status"],
    "properties": {
      "city": {"type": "string", "minLength": 1, "maxLength": 80},
      "locality": {"type": "string", "minLength": 1, "maxLength": 120},
      "status": {"enum": ["upcoming", "under_construction", "ready_to_move"]},
      "rera_registration": {"type": "string", "maxLength": 60},
      "possession": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$", "description": "Year and month, e.g. 2027-12"},
      "total_units": {"type": "integer", "minimum": 1, "maximum": 100000},
      "amenities": {"type": "array", "maxItems": 30, "items": {"type": "string", "maxLength": 60}},
      "description": {"type": "string", "maxLength": 1000}
    }
  }
}
