{
  "key": "sales_agent",
  "name": "Sales agent",
  "plural_name": "Sales agents",
  "description": "A member of the sales team callers can be connected to.",
  "schema_version": 1,
  "searchable_fields": ["name"],
  "display_template": {"title": "{name}", "subtitle": "Sales"},
  "attributes_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "languages": {
        "type": "array",
        "maxItems": 10,
        "items": {"type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"}
      },
      "experience_years": {"type": "integer", "minimum": 0, "maximum": 60}
    }
  }
}
