{
  "key": "appointment_request",
  "name": "Appointment request",
  "schema_version": 1,
  "subject_types": ["doctor", "service"],
  "stages": ["new", "contacted", "confirmed_externally", "closed", "cancelled"],
  "initial_stage": "new",
  "terminal_stages": ["closed", "cancelled"],
  "payload_schema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "preferred_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
      "preferred_time_start": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
      "preferred_time_end": {"type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$"},
      "is_new_patient": {"type": "boolean"}
    }
  }
}
