# Template only. Keep actual values in .env, which is ignored by Git.
# Merge missing settings into your existing .env; do not replace working values.

# Existing voice pipeline
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
SARVAM_API_KEY=
SARVAM_STT_LANGUAGE=hi-IN
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# Phase 1 database settings; not consumed by the current voice agent.
# Use a dedicated Supabase Cloud DEVELOPMENT project with fictional data only.
SUPABASE_URL=
SUPABASE_PROJECT_REF=
# Project Settings > API Keys: publishable key (not a secret/service-role key).
SUPABASE_PUBLISHABLE_KEY=

# Dashboard Connect > PostgreSQL URI: direct or session-pooler connection.
# Use port 5432, database postgres, and only the sslmode=require query parameter.
# Percent-encode special characters in the password.
# Use the copied hostname without surrounding square brackets.
# Migration credentials are privileged: setup only, never the runtime agent.
MIGRATION_DATABASE_URL=
# Restricted runtime only; never copy migration credentials here.
# Initial provisioning writes the actual value to ignored .env.runtime (0600).
# Tests load that file explicitly; the existing voice .env remains unchanged.
DATABASE_URL=

# Dashboard: HTTPS in deployment; loopback HTTP is permitted for local development.
CLINIC_DASHBOARD_ORIGIN=http://127.0.0.1:8080
# Inject externally for request encryption and authorized contact viewing.
# JSON object mapping key version -> base64-encoded random 32-byte AES key.
# Never place real encryption keys in this template or send them in chat.
CLINIC_PII_KEYS=
CLINIC_PII_KEY_VERSION=

# Optional local semantic document search. Run `docker compose up -d qdrant`
# and install the semantic dependency group before enabling it.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=clinic_document_sections
# QDRANT_API_KEY=  # only for a secured/hosted Qdrant deployment
QDRANT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
