# Template only. Keep actual values in .env, which is ignored by Git.
# Merge missing settings into your existing .env; do not replace working values.

# Existing voice pipeline
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
SARVAM_API_KEY=
SARVAM_STT_LANGUAGE=hi-IN
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=

# Phase 1 database settings; not consumed by the current voice agent.
# Use a dedicated Supabase Cloud DEVELOPMENT project with fictional data only.
SUPABASE_URL=
SUPABASE_PROJECT_REF=
# Project Settings > API Keys: publishable key (not a secret/service-role key).
SUPABASE_PUBLISHABLE_KEY=

# Dashboard Connect > PostgreSQL URI: direct or session-pooler connection.
# Use port 5432, database postgres, and only the sslmode=require query parameter.
# Percent-encode special characters in the password.
# Use the copied hostname without surrounding square brackets.
# Migration credentials are privileged: setup only, never the runtime agent.
MIGRATION_DATABASE_URL=
# Restricted runtime only; never copy migration credentials here.
# Initial provisioning writes the actual value to ignored .env.runtime (0600).
# Tests load that file explicitly; the existing voice .env remains unchanged.
DATABASE_URL=

# Dashboard: the Next.js frontend's origin (it proxies /api/* to this API on :8080).
# Several are allowed, comma-separated, e.g. http://127.0.0.1:3000,http://localhost:3000.
# Each must match exactly what the browser sends. HTTPS in deployment; loopback HTTP is
# permitted for local development. A session cookie belongs to one origin: sign in on each.
DASHBOARD_ORIGIN=http://127.0.0.1:3000
# Inject externally for request encryption and authorized contact viewing.
# JSON object mapping key version -> base64-encoded random 32-byte AES key.
# Never place real encryption keys in this template or send them in chat.
CLINIC_PII_KEYS=
CLINIC_PII_KEY_VERSION=
# CRM phone lookup: base64-encoded random 32-byte HMAC key (finds returning contacts
# without storing phone numbers in clear). Generate: openssl rand -base64 32
PRAXIMA_LOOKUP_KEY=

# Self-service sign-up: anyone may register (Supabase Auth) and create their own organization.
# "true" for development or an open SaaS; leave empty to onboard organizations yourself.
PRAXIMA_SELF_SIGNUP=

# Optional local semantic document search. Run `docker compose up -d qdrant`
# and install the semantic dependency group before enabling it.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=clinic_document_sections
# QDRANT_API_KEY=  # only for a secured/hosted Qdrant deployment
QDRANT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# /api/v1 knowledge search uses its own collection (the voice agent's stays separate).
PRAXIMA_KNOWLEDGE_COLLECTION=praxima_knowledge

# New vendor-neutral schema managed by Alembic (docs/architecture/0001-sqlalchemy-and-alembic.md).
# Always an EXTERNAL PostgreSQL 16+ (never Docker): your local Postgres install or a Supabase
# Postgres database. Owner role, migrations only. Examples:
#   local:    postgresql://<user>:<password>@127.0.0.1:5432/praxima
#   Supabase: postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres?sslmode=require
# Use the direct or session-pooler URL on port 5432, never the transaction pooler (6543):
# migrations need a session for their advisory lock.
DB_OWNER_DATABASE_URL=
# /api/v1 connects to the same database. Target: a dedicated `app_api` role (no owner rights);
# for local development the owner URL above also works. Unset → /api/v1 answers 503.
APP_API_DATABASE_URL=

# Voice agent (step 4b). "release": answer calls from the agent's published release (the
# called number picks the agent). "legacy" (default): the old Clinic A snapshot.
PRAXIMA_VOICE_SOURCE=legacy
# The voice worker's own restricted login: it may only look up releases and record calls
# (grant with: uv run python scripts/voice_runtime.py grant <role>). Empty → falls back to
# APP_API_DATABASE_URL with a warning (development only).
PRAXIMA_RUNTIME_DATABASE_URL=
# Console mode (`uv run src/agent.py console`) has no called number: act as a call to this
# routed number, e.g. +912212345678.
PRAXIMA_CONSOLE_NUMBER=
