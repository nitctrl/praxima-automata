# Template only. Real values come from secret management in deployment, or from an
# ignored local .env. Never commit real keys, numbers or connection strings.

# ── LiveKit worker ─────────────────────────────────────────────────
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Speech and language model ──────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
SARVAM_API_KEY=
# "unknown" = per-utterance language detection (Hindi, English, mixed, regional).
SARVAM_STT_LANGUAGE=unknown
# Voice used before the clinic loads; afterwards the clinic's default language.
SARVAM_TTS_LANGUAGE=hi-IN
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=shubh

# ── Tenant routing ─────────────────────────────────────────────────
# Each SIP call's clinic is resolved from the LiveKit trunk ID + called number.
# Must match phone_numbers.provider. Unknown numbers hear a fixed message and hang up.
TELEPHONY_PROVIDER=plivo
# Local `console` sessions only (no dialled number). Leave unset in production.
# CONSOLE_CLINIC_ID=

# ── Database (restricted clinic_runtime role, never a migration/owner login) ──
# Supabase pooler URI with sslmode=require. Port 6543 (transaction pooler) is
# recommended for many concurrent calls; 5432 (session pooler / direct) also works.
DATABASE_URL=
SUPABASE_PROJECT_REF=

# ── PII encryption (names and numbers are encrypted before any database write) ──
# JSON object: key version -> base64 of 32 random bytes. Shared with the platform.
CLINIC_PII_KEYS=
CLINIC_PII_KEY_VERSION=

# ── Optional semantic search over published documents ──────────────
# Without QDRANT_URL retrieval uses the in-process lexical rank only.
QDRANT_URL=
QDRANT_COLLECTION=clinic_document_sections
# QDRANT_API_KEY=
QDRANT_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
QDRANT_SEARCH_TIMEOUT_SECONDS=0.8
# QDRANT_SCORE_THRESHOLD=
QDRANT_VERSION_GRACE_SECONDS=1800

# ── Optional shared cache and per-clinic concurrency ───────────────
# Without REDIS_URL every call reads Postgres and only the database limit applies.
REDIS_URL=
REDIS_TIMEOUT_SECONDS=0.1
# Keep equal to the platform's start_call limit (currently 4). 0 disables.
CLINIC_MAX_CONCURRENT_CALLS=4

# ── Call limits and logging ────────────────────────────────────────
# Hard ceiling per call; the platform's per-call deadline applies if shorter.
CLINIC_MAX_CALL_SECONDS=900
# "json" for structured production logs.
LOG_FORMAT=json
